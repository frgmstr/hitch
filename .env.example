# ── Hitch: Automobile Buying Assistant (Public Profile) ─────────────────────
# Copy this file to ".env" and fill in your values.  Never commit .env!

# ── Required API Key ─────────────────────────────────────────────────────────
VISOR_API_KEY=your_visor_vin_api_key_here

# ── Personalization: which automobile are you shopping? ─────────────────────
TARGET_MAKE=TOYOTA
TARGET_MODEL=4RUNNER
TARGET_YEARS=2023-2025

# ── Optional: cookie authentication for Visor.vin premium features ───────────
# If VISOR_API_KEY is not enough (some endpoints require a subscription), you can
# also provide cookies exported from your visor.vin browser session using the
# EditThisCookie extension.  Leave empty if you only need basic API access.
VISOR_COOKIE=

# ── Optional: override where report/rubric input/output files live ───────────
# Defaults to ./archives (relative to the profile root) if unset.
HERMES_ARCHIVE_DIR=/absolute/path/to/your/archives

# ── Optional: photo source for hero images in the report ─────────────────────
# Default is "visor-vin" (uses the listing detail endpoint's photos array).
# Set to autohero / carsheet / dealer-api and add that provider's API key below.
PHOTO_PROVIDER=visor-vin

# ── Optional: alternative photo provider API keys ────────────────────────────
AUTOHERO_API_KEY=your_autohero_api_key_here  # if PHOTO_PROVIDER=autohero
CAR_SHEET_API_KEY=your_car_sheet_api_key_here  # if PHOTO_PROVIDER=carsheet